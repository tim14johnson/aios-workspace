# AiOS local secrets — COPY this file to ".aios.env" (same folder) and fill in your keys.
# ".aios.env" is git-ignored and never committed. Do NOT put real keys in this .example file.
#
#   cp .aios.env.example .aios.env
#   then edit .aios.env and paste your key.

# Anthropic (Claude) API key — enables the CLOUD tier of Deep Review (tools/aicode-review).
# Get one at https://console.anthropic.com/  (pay-per-use; a code review costs pennies).
ANTHROPIC_API_KEY=

# Optional: override the cloud review model (defaults to a current Claude model).
# AICODE_CLOUD_MODEL=claude-opus-4-20250514

# Optional: override the free local reviewer model used when no cloud key is set.
# AICODE_REVIEW_MODEL=qwen3.6:latest

# Perplexity API key — enables the Perplexity member of the senior blueprint and pre-commit council.
# Get an API key through the Perplexity API portal; this is separate from a Perplexity subscription.
PERPLEXITY_API_KEY=

# Senior-council model overrides. Defaults are Claude Sonnet and Perplexity Sonar Pro.
# SENIOR_COUNCIL_CLAUDE_MODEL=claude-sonnet-4-5
# SENIOR_COUNCIL_PERPLEXITY_MODEL=sonar-pro
